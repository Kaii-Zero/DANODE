<!DOCTYPE html>
<html>
<head>
    <title>Quản lý dịch vụ</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-8">
    <div class="max-w-6xl mx-auto">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold">Quản lý dịch vụ</h1>
            <div class="flex gap-3">
                <a href="/subs/create" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg transition">
                    🛒 Mua dịch vụ (User)
                </a>
                <a href="/dv/create" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition">
                    + Thêm dịch vụ
                </a>
            </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <table class="w-full">
                <thead class="bg-gray-200">
                    <tr class="text-left">
                        <th class="p-3">Tên dịch vụ</th>
                        <th class="p-3">Loại</th>
                        <th class="p-3">Gói</th>
                        <th class="p-3">Nhà cung cấp</th>
                        <th class="p-3">Giá</th>
                        <th class="p-3">Giảm giá</th>
                        <th class="p-3 text-center" colspan="2">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% services.forEach(service => { %>
                    <tr class="border-t hover:bg-gray-50">
                        <td class="p-3 font-medium"><%= service.name %></td>
                        <td class="p-3"><%= service.type || '-' %></td>
                        <td class="p-3">
                            <span class="bg-blue-100 text-blue-600 px-2 py-1 rounded-full text-xs">
                                <%= service.packageType || 'Cơ bản' %>
                            </span>
                        </td>
                        <td class="p-3"><%= service.provider || '-' %></td>
                        <td class="p-3 text-green-600 font-semibold">$<%= service.price %></td>
                        <td class="p-3">
                            <% if(service.discount > 0) { %>
                                <span class="bg-red-100 text-red-600 px-2 py-1 rounded-full text-xs">
                                    -<%= service.discount %>%
                                </span>
                            <% } else { %>
                                <span class="text-gray-400">0%</span>
                            <% } %>
                        </td>
                        
                        <td class="p-3 text-center">
                            <div class="flex gap-2">
                                <a href="/dv/edit/<%= service._id %>" 
                                   class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1 rounded-lg text-sm">
                                    Sửa
                                </a>
                                <form action="/dv/delete/<%= service._id %>" method="POST" 
                                      onsubmit="return confirm('Xóa dịch vụ <%= service.name %>?')">
                                    <button type="submit" 
                                            class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-lg text-sm">
                                        Xóa
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            
            <% if(services.length === 0) { %>
                <div class="text-center py-8 text-gray-400">
                    Chưa có dịch vụ nào. <a href="/dv/create" class="text-blue-500">Thêm dịch vụ</a>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>