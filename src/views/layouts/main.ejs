<!DOCTYPE html>
<html>
<head>
    <title>App</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Dropdown menu styles */
        .dropdown {
            position: relative;
            display: inline-block;
        }
        
        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 40px;
            background-color: white;
            min-width: 220px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            border-radius: 12px;
            z-index: 1000;
            overflow: hidden;
        }
        
        .dropdown-content a {
            color: #374151;
            padding: 12px 16px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.2s;
            border-bottom: 1px solid #f3f4f6;
        }
        
        .dropdown-content a:last-child {
            border-bottom: none;
        }
        
        .dropdown-content a:hover {
            background-color: #f3f4f6;
        }
        
        .dropdown:hover .dropdown-content {
            display: block;
        }
        
        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            cursor: pointer;
            border: 2px solid white;
            transition: transform 0.2s;
        }
        
        .avatar:hover {
            transform: scale(1.05);
        }
        
        .notification-badge {
            position: relative;
            cursor: pointer;
        }
        
        .notification-badge .badge {
            position: absolute;
            top: -8px;
            right: -8px;
            background-color: #ef4444;
            color: white;
            border-radius: 50%;
            padding: 2px 6px;
            font-size: 10px;
            font-weight: bold;
        }
        
        .nav-active {
            color: #60a5fa;
        }
    </style>
</head>

<body class="bg-gray-100">

<!-- Navbar -->
<div class="flex bg-gray-800 text-white p-4 shadow-lg">

    <!-- Trang chủ -->
    <div class="w-1/3 flex items-center">
        <a href="/" class="text-xl font-bold hover:text-blue-400 transition">🏠 Trang chủ</a>
    </div>

    <!-- Menu -->
    <div class="w-2/3 flex justify-end items-center gap-6">
        <a href="/dv" class="hover:text-blue-400 transition flex items-center gap-2">
            <i class="fas fa-cubes"></i> Service
        </a>
        <a href="/subs" class="hover:text-blue-400 transition flex items-center gap-2">
            <i class="fas fa-ticket-alt"></i> Subscriptions
        </a>
        
        <!-- BIỂU TƯỢNG THÔNG BÁO -->
        <a href="/notifications" class="notification-badge hover:text-blue-400 transition flex items-center gap-2">
            <i class="fas fa-bell text-xl"></i>
            <!-- SỬA: Kiểm tra biến tồn tại -->
            <% if (typeof notificationCount !== 'undefined' && notificationCount > 0) { %>
                <span class="badge"><%= notificationCount %></span>
            <% } %>
        </a>
        
        <!-- BIỂU TƯỢNG ACCOUNT -->
        <div class="dropdown">
            <% if (user && user.id) { %>
                <img src="<%= user.avatar || '/images/default-avatar.png' %>" 
                     alt="Avatar" 
                     class="avatar"
                     onerror="this.src='/images/default-avatar.png'">
                <div class="dropdown-content">
                    <a href="/profile">
                        <i class="fas fa-user-circle text-gray-600 w-5"></i>
                        <span>Thông tin tài khoản</span>
                    </a>
                    <a href="/settings">
                        <i class="fas fa-cog text-gray-600 w-5"></i>
                        <span>Cài đặt</span>
                    </a>
                    <a href="/settings/notifications">
                        <i class="fas fa-bell text-gray-600 w-5"></i>
                        <span>Cài đặt thông báo</span>
                    </a>
                    <hr class="my-1 border-gray-200">
                    <a href="/logout" class="text-red-600">
                        <i class="fas fa-sign-out-alt text-red-600 w-5"></i>
                        <span>Đăng xuất</span>
                    </a>
                </div>
            <% } else { %>
                <i class="fas fa-user-circle text-3xl cursor-pointer hover:text-blue-400 transition"></i>
                <div class="dropdown-content">
                    <a href="/login">
                        <i class="fas fa-sign-in-alt text-blue-600 w-5"></i>
                        <span>Đăng nhập</span>
                    </a>
                    <a href="/register">
                        <i class="fas fa-user-plus text-green-600 w-5"></i>
                        <span>Đăng ký</span>
                    </a>
                </div>
            <% } %>
        </div>
    </div>

</div>

<!-- 🔥 QUAN TRỌNG NHẤT -->
<div class="p-6">
    <%- body %>
</div>

<script>
    const currentPath = window.location.pathname;
    document.querySelectorAll('.dropdown-content a, .notification-badge, .flex > a').forEach(link => {
        if (link.getAttribute('href') === currentPath) {
            link.classList.add('nav-active');
        }
    });
</script>

</body>
</html>