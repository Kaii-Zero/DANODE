<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="https://cdn.tailwindcss.com"></script>

    <title>Register</title>

</head>

<body class="flex items-center justify-center h-screen bg-gray-100">

    <form
        action="/register"
        method="POST"
        class="bg-white p-6 rounded-2xl shadow-lg w-96"
    >

        <h2 class="text-2xl font-bold text-center mb-6">
            Register
        </h2>

        <!-- Username -->
        <input
            type="text"
            name="username"
            placeholder="Username"
            class="border p-3 w-full mb-4 rounded-lg"
        >

        <!-- Email -->
        <input
            type="email"
            name="email"
            placeholder="Email"
            class="border p-3 w-full mb-4 rounded-lg"
        >

        <!-- Password -->
        <input
            type="password"
            name="password"
            placeholder="Password"
            class="border p-3 w-full mb-5 rounded-lg"
        >

        <!-- Button -->
        <button
            type="submit"
            class="bg-green-500 hover:bg-green-600 text-white w-full p-3 rounded-lg"
        >
            Register
        </button>

        <p class="text-center text-sm mt-5">

            Already have an account?

            <a
                href="/login"
                class="text-blue-500 hover:underline"
            >
                Login
            </a>

        </p>

    </form>

</body>

</html>