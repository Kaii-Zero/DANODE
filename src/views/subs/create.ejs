<!DOCTYPE html>
<html>
<head>
    <title>Đăng ký dịch vụ</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 p-6">

<h1 class="text-2xl font-bold text-center mb-6">
    Chọn dịch vụ đăng ký
</h1>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">

    <% services.forEach(service => { %>

        <div class="bg-white p-4 rounded shadow">

            <img src="<%= service.logo %>" class="w-full h-40 object-cover rounded">

            <h2 class="text-xl font-bold mt-2">
                <%= service.name %>
            </h2>

            <p class="text-green-600 font-semibold">
                <%= service.price %>$
            </p>

            <p>
                Loại: <%= service.type %>
            </p>

            <p>
                Giảm: <%= service.discount || 0 %>%
            </p>

            <form action="/subs/create" method="POST">

                <input type="hidden" name="serviceId" value="<%= service._id %>">

                <button class="bg-blue-500 text-white w-full mt-3 p-2 rounded">
                    Đăng ký
                </button>

            </form>

        </div>

    <% }) %>

</div>

</body>
</html>