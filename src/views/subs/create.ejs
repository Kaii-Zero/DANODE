<!DOCTYPE html>
<html>
<head>
    <title>Đăng ký dịch vụ</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen">

<!-- HEADER -->
<div class="text-center py-8">
    <h1 class="text-3xl font-bold text-gray-800">
        Chọn dịch vụ đăng ký
    </h1>
    <p class="text-gray-500 mt-2">
        Chọn gói phù hợp và số lượng bạn muốn
    </p>
</div>

<!-- GRID -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto px-4">

    <% services.forEach(service => { %>

        <!-- CARD -->
        <div class="bg-white rounded-xl shadow-md hover:shadow-xl transition p-4 flex flex-col">

            <!-- IMAGE -->
            <img src="<%= service.logo %>"
                 class="w-full h-40 object-cover rounded-lg">

            <!-- NAME -->
            <h2 class="text-xl font-bold mt-3 text-gray-800">
                <%= service.name %>
            </h2>

            <!-- PRICE -->
            <p class="text-green-600 font-bold text-lg mt-1">
                $<%= service.price %>
            </p>

            <!-- INFO -->
            <div class="text-sm text-gray-500 mt-2 space-y-1">
                <p>Loại: <%= service.type %></p>
                <p>Giảm: <%= service.discount || 0 %>%</p>
                <p>Nhà cung cấp: <%= service.provider %></p>
            </div>

            <!-- FORM -->
            <form action="/subs/create"
                  method="POST"
                  class="mt-4 space-y-3">

                <!-- SERVICE ID -->
                <input type="hidden"
                       name="serviceId"
                       value="<%= service._id %>">

                <!-- QUANTITY -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-1">
                        Số lượng gói
                    </label>

                    <select name="quantity"
                            class="border w-full p-2 rounded-lg focus:ring-2 focus:ring-blue-400">

                        <option value="1">1 gói</option>
                        <option value="2">2 gói</option>
                        <option value="3">3 gói</option>
                        <option value="6">6 gói</option>

                    </select>
                </div>

                <!-- BUTTON -->
                <button type="submit"
                        class="bg-blue-500 hover:bg-blue-600 text-white w-full p-2 rounded-lg font-semibold transition">

                    Đăng ký ngay

                </button>

            </form>

        </div>

    <% }) %>

</div>

</body>
</html>