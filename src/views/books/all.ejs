

<!-- Stats -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <!-- Cột trái: Tổng dịch vụ + Chi phí tháng -->
    <div class="flex flex-col gap-3 max-w-[430px] ml-10">

        <!-- Tổng dịch vụ -->
        <div class="bg-white p-4 rounded-2xl shadow h-32 flex flex-col justify-center">
            <h2 class="text-gray-500 text-sm">Tổng dịch vụ</h2>
            <p class="text-2xl font-bold mt-2 text-blue-600">
                <%= books.length %>
            </p>
        </div>

        <!-- Chi phí tháng -->
        <div class="bg-white p-4 rounded-2xl shadow h-32 flex flex-col justify-center">
            <h2 class="text-gray-500 text-sm">Chi phí tháng</h2>

            <%
                const monthlyTotal = books.reduce((sum, book) => {
                    return sum + Number(book.price || 0)
                }, 0)
            %>

            <p class="text-2xl font-bold mt-2 text-green-600">
                $<%= monthlyTotal %>
            </p>
        </div>
    </div>

    <!-- Cột phải: Sắp hết hạn -->
    <div class="md:col-span-2 bg-white p-6 rounded-2xl shadow min-h-[280px] max-w-[1200px] mr-10 mb-10">
        <h2 class="text-gray-500 text-lg">Sắp hết hạn</h2>

        <%
            const today = new Date()

            const expiring = books.filter(book => {
                if (!book.renewalDate) return false

                const renewal = new Date(book.renewalDate)
                renewal.setHours(0, 0, 0, 0)

                const now = new Date(today)
                now.setHours(0, 0, 0, 0)

                const diffDays = Math.ceil(
                    (renewal - now) / (1000 * 60 * 60 * 24)
                )

                return diffDays >= 0 && diffDays <= 7
            })
        %>

        <div class="flex items-center gap-4 mt-4">
            <p class="text-5xl font-bold text-red-500">
                <%= expiring.length %>
            </p>

            <div>
                <p class="text-gray-700 font-medium">
                    dịch vụ sẽ gia hạn trong 7 ngày tới
                </p>
                <p class="text-sm text-gray-400">
                    Kiểm tra để tránh gián đoạn sử dụng
                </p>
            </div>
        </div>

        <% if (expiring.length > 0) { %>
            <div class="mt-6 divide-y">
                <% expiring.forEach(sub => { %>
                    <div class="flex justify-between items-center py-3">
                        <div>
                            <p class="font-semibold text-gray-800">
                                <%= sub.name %>
                            </p>
                            <p class="text-sm text-gray-400">
                                <%= sub.category || 'Khác' %>
                            </p>
                        </div>

                        <div class="text-right">
                            <p class="text-sm text-gray-500">
                                <%= new Intl.DateTimeFormat('vi-VN', {
                                    day: '2-digit',
                                    month: '2-digit',
                                    year: 'numeric'
                                }).format(new Date(sub.renewalDate)) %>
                            </p>

                            <p class="text-xs text-red-400">
                                còn <%= Math.ceil(
                                    (new Date(sub.renewalDate).setHours(0,0,0,0) -
                                     new Date(new Date().setHours(0,0,0,0))) /
                                    (1000 * 60 * 60 * 24)
                                ) %> ngày
                            </p>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="mt-8 text-center text-gray-400">
                Không có dịch vụ nào sắp hết hạn
            </div>
        <% } %>
    </div>

</div>

    

    <!-- Subscription List -->
    <div class="bg-white p-6 rounded-2xl shadow ml-10 mr-10">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-semibold">Danh sách dịch vụ</h2>
            <a href="/subs/create" class="bg-blue-500 text-white px-4 py-2 rounded-lg">
                + Thêm dịch vụ
            </a>
        </div>

        <table class="w-full text-left">
            <thead>
                <tr class="border-b">
                    <th class="py-2">Tên</th>
                    <th class="py-2">Giá</th>
                    <th class="py-2">Chu kỳ</th>
                    <th class="py-2">Ngày gia hạn</th>
                    <th class="py-2">Trạng thái</th>
                </tr>
            </thead>

            <tbody>

                <% books.forEach(book => { %>

                    <tr class="border-b">

                        <td class="py-2">
                            <%= book.name %>
                        </td>

                        <td class="py-2">
                            $<%= book.price || 0 %>
                        </td>

                        <td class="py-2">
                            <%= book.cycle || 'N/A' %>
                        </td>

                        <td class="py-2">

                            <% if (book.renewalDate) { %>

                                <%= new Date(book.renewalDate)
                                    .toLocaleDateString('vi-VN') %>

                            <% } else { %>

                                Không có

                            <% } %>

                        </td>

                        <td class="py-2">
                            <%= book.status || 'Unknown' %>
                        </td>

                    </tr>

                <% }) %>

            </tbody>
        </table>
        
</div>

</div>
<canvas id="myChart" height="50" class="bg-white p-6 rounded-2xl shadow mt-10 mb-10 ml-10 mr-10"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const labels = <%-  JSON.stringify((books || []).map(b => b.name)) %>;

    const prices = <%-  JSON.stringify((books || []).map(b => b.price || 0)) %>;

    const cycles = <%-  JSON.stringify((books || []).map(b => b.cycle || '')) %>;

    const renewals = <%-  JSON.stringify(
        (books || []).map(book => {
            if (!book.renewalDate) return 'Không có';

            return new Intl.DateTimeFormat('vi-VN', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            }).format(new Date(book.renewalDate));
        })
    ) %>;

    const statuses = <%-  JSON.stringify((books || []).map(book => book.status || '')) %>;

    // Màu ngẫu nhiên cho từng cột
    const backgroundColors = labels.map(() => {
        const r = Math.floor(Math.random() * 200);
        const g = Math.floor(Math.random() * 200);
        const b = Math.floor(Math.random() * 200);

        return `rgba(${r}, ${g}, ${b}, 0.7)`;
    });

    const borderColors = backgroundColors.map(color =>
        color.replace('0.7', '1')
    );

    new Chart(document.getElementById('myChart'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Chi phí dịch vụ',
                data: prices,
                backgroundColor: backgroundColors,
                borderColor: borderColors,
                borderWidth: 1,
                borderRadius: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,

            plugins: {
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const i = context.dataIndex;

                            return [
                                `Giá: $${prices[i]}`,
                                `Chu kỳ: ${cycles[i]}`,
                                `Gia hạn: ${renewals[i]}`,
                                `Trạng thái: ${statuses[i]}`
                            ];
                        }
                    }
                },

                legend: {
                    display: false
                }
            },

            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>

<style>
    #myChart {
        max-height: 300px;
    }
</style>
